PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Use ONE MongoDB variable. Atlas: copy Connect > Drivers > Node.js.
MONGODB_URI=mongodb://127.0.0.1:27017/autoapplyai
# Use ONE Redis variable. Upstash needs its Redis/TLS URL, not the HTTPS REST URL.
UPSTASH_REDIS_URL=redis://127.0.0.1:6379

# Hosted examples (copy the actual URLs from Atlas and Upstash):
# MONGODB_URI="mongodb+srv://USERNAME:ENCODED_PASSWORD@YOUR_CLUSTER/EXISTING_DATABASE?retryWrites=true&w=majority"
# UPSTASH_REDIS_URL="rediss://default:PASSWORD@YOUR_ENDPOINT:6379"
# Remove old MONGO_URI and REDIS_URL entries when using the names above.

# Set two different, long random secrets before starting the backend.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ENABLE_WORKERS=true

# Optional: ordinary search and retrieved source excerpts do not need an LLM key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# The Docker/Render deployment supplies these automatically where appropriate.
# SERVE_FRONTEND=true
# FRONTEND_DIST=/app/frontend/dist
# UPLOAD_DIR=/data/resumes
# TRUST_PROXY_HOPS=1
# CRAWLER_CONCURRENCY=1
# CLIENT_ORIGIN=https://your-custom-domain.example
